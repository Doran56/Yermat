# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
# .expo/* plutôt que .expo/ pour que git descende dans le dossier et honore
# la négation ci-dessous : .expo/types/router.d.ts reste suivi, sinon un clone
# frais perd les types de typedRoutes et `tsc --noEmit` dégrade les Href en string.
.expo/*
!.expo/types/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env
.env*.local

# typescript
*.tsbuildinfo

app-example

# generated native folders
/ios
/android

